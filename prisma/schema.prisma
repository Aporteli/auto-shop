generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Language {
  EN
  RU
}

// ─── Users & Authentication ────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String?   @db.VarChar(255)
  googleId      String?   @unique @db.VarChar(128)
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  phone         String?   @db.VarChar(30)
  avatar        String?   @db.VarChar(500)
  role          UserRole  @default(USER)
  language      Language  @default(EN)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings      Listing[]
  favorites     Favorite[]
  searches      SavedSearch[]
  reviews       Review[]
  messages      Message[]       @relation("SentMessages")
  received      Message[]       @relation("ReceivedMessages")
  dealership    Dealer?

  @@index([email])
  @@map("users")
}

enum UserRole {
  USER
  DEALER
  ADMIN
}

// ─── Vehicle Reference Data (bilingual: EN + RU) ──────────────────

model Manufacturer {
  id       Int     @id @default(autoincrement())
  nameEn   String  @db.VarChar(100)
  nameRu   String  @db.VarChar(100)
  logo     String? @db.VarChar(500)
  country  String? @db.VarChar(100)

  models   Model[]

  @@unique([nameEn])
  @@unique([nameRu])
  @@map("manufacturers")
}

model Model {
  id             Int          @id @default(autoincrement())
  nameEn         String       @db.VarChar(100)
  nameRu         String       @db.VarChar(100)
  manufacturerId Int

  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  listings       Listing[]

  @@unique([manufacturerId, nameEn])
  @@index([manufacturerId])
  @@map("models")
}

model BodyType {
  id       Int       @id @default(autoincrement())
  nameEn   String    @unique @db.VarChar(60)
  nameRu   String    @unique @db.VarChar(60)
  icon     String?   @db.VarChar(500)

  listings Listing[]

  @@map("body_types")
}

model FuelType {
  id       Int       @id @default(autoincrement())
  nameEn   String    @unique @db.VarChar(60)
  nameRu   String    @unique @db.VarChar(60)

  listings Listing[]

  @@map("fuel_types")
}

model Transmission {
  id       Int       @id @default(autoincrement())
  nameEn   String    @unique @db.VarChar(60)
  nameRu   String    @unique @db.VarChar(60)

  listings Listing[]

  @@map("transmissions")
}

model DriveType {
  id       Int       @id @default(autoincrement())
  nameEn   String    @unique @db.VarChar(60)
  nameRu   String    @unique @db.VarChar(60)

  listings Listing[]

  @@map("drive_types")
}

model Color {
  id       Int       @id @default(autoincrement())
  nameEn   String    @unique @db.VarChar(60)
  nameRu   String    @unique @db.VarChar(60)
  hex      String?   @db.VarChar(7)

  listings Listing[]

  @@map("colors")
}

model VehicleCategory {
  id       Int       @id @default(autoincrement())
  nameEn   String    @unique @db.VarChar(80)
  nameRu   String    @unique @db.VarChar(80)
  slug     String    @unique @db.VarChar(80)
  icon     String?   @db.VarChar(500)

  listings Listing[]

  @@map("vehicle_categories")
}

// ─── Location (bilingual) ──────────────────────────────────────────

model Country {
  id       Int      @id @default(autoincrement())
  nameEn   String   @unique @db.VarChar(100)
  nameRu   String   @unique @db.VarChar(100)
  code     String   @unique @db.VarChar(3)

  cities   City[]

  @@map("countries")
}

model City {
  id        Int      @id @default(autoincrement())
  nameEn    String   @db.VarChar(100)
  nameRu    String   @db.VarChar(100)
  countryId Int

  country   Country  @relation(fields: [countryId], references: [id])
  listings  Listing[]

  @@unique([countryId, nameEn])
  @@index([countryId])
  @@map("cities")
}

// ─── Listings (Core) ───────────────────────────────────────────────

model Listing {
  id               Int              @id @default(autoincrement())
  userId           Int
  modelId          Int
  categoryId       Int
  bodyTypeId       Int?
  fuelTypeId       Int?
  transmissionId   Int?
  driveTypeId      Int?
  colorId          Int?
  cityId           Int?

  listingType      ListingType      @default(SALE)
  status           ListingStatus    @default(ACTIVE)

  year             Int
  price            Decimal          @db.Decimal(12, 2)
  currency         Currency         @default(USD)
  priceNegotiable  Boolean          @default(false)

  mileage          Int?
  mileageUnit      MileageUnit      @default(KM)
  engineVolume     Decimal?         @db.Decimal(3, 1)
  enginePower      Int?
  cylinders        Int?
  doors            Int?
  seats            Int?

  vin              String?          @db.VarChar(17)
  plateNumber      String?          @db.VarChar(20)
  customsCleared   Boolean          @default(false)
  isVip            Boolean          @default(false)
  has360           Boolean          @default(false)
  damaged          Boolean          @default(false)
  steeringWheel    SteeringWheel    @default(LEFT)

  interiorColorEn    String?        @db.VarChar(60)
  interiorColorRu    String?        @db.VarChar(60)
  interiorMaterialEn String?        @db.VarChar(60)
  interiorMaterialRu String?        @db.VarChar(60)
  exchange           Boolean        @default(false)
  techInspection     Boolean        @default(false)
  catalyst           Boolean        @default(false)
  thirdRowSeats      Boolean        @default(false)
  airbags            Int?
  isTurbo            Boolean        @default(false)

  titleEn          String?          @db.VarChar(255)
  titleRu          String?          @db.VarChar(255)
  descriptionEn    String?          @db.Text
  descriptionRu    String?          @db.Text

  views            Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  expiresAt        DateTime?

  user             User             @relation(fields: [userId], references: [id])
  model            Model            @relation(fields: [modelId], references: [id])
  category         VehicleCategory  @relation(fields: [categoryId], references: [id])
  bodyType         BodyType?        @relation(fields: [bodyTypeId], references: [id])
  fuelType         FuelType?        @relation(fields: [fuelTypeId], references: [id])
  transmission     Transmission?    @relation(fields: [transmissionId], references: [id])
  driveType        DriveType?       @relation(fields: [driveTypeId], references: [id])
  color            Color?           @relation(fields: [colorId], references: [id])
  city             City?            @relation(fields: [cityId], references: [id])

  images           ListingImage[]
  features         ListingFeature[]
  stickers         ListingSticker[]
  favorites        Favorite[]
  auctionBids      AuctionBid[]
  rentals          Rental[]

  @@index([userId])
  @@index([modelId])
  @@index([categoryId])
  @@index([status, listingType])
  @@index([year])
  @@index([price])
  @@index([createdAt])
  @@index([vin])
  @@map("listings")
}

enum ListingType {
  SALE
  RENT
  AUCTION
}

enum ListingStatus {
  ACTIVE
  SOLD
  RENTED
  EXPIRED
  DRAFT
  MODERATION
}

enum Currency {
  USD
  EUR
  GEL
}

enum MileageUnit {
  KM
  MI
}

enum SteeringWheel {
  LEFT
  RIGHT
}

// ─── Listing Media ─────────────────────────────────────────────────

model ListingImage {
  id        Int     @id @default(autoincrement())
  listingId Int
  url       String  @db.VarChar(500)
  position  Int     @default(0)
  is360     Boolean @default(false)

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

// ─── Features & Stickers (bilingual) ──────────────────────────────

model Feature {
  id       Int              @id @default(autoincrement())
  nameEn   String           @unique @db.VarChar(120)
  nameRu   String           @unique @db.VarChar(120)
  groupEn  String?          @db.VarChar(80)
  groupRu  String?          @db.VarChar(80)

  listings ListingFeature[]

  @@map("features")
}

model ListingFeature {
  id        Int     @id @default(autoincrement())
  listingId Int
  featureId Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id])

  @@unique([listingId, featureId])
  @@map("listing_features")
}

model Sticker {
  id     Int     @id @default(autoincrement())
  nameEn String  @unique @db.VarChar(80)
  nameRu String  @unique @db.VarChar(80)
  color  String? @db.VarChar(7)
  icon   String? @db.VarChar(500)

  listings ListingSticker[]

  @@map("stickers")
}

model ListingSticker {
  id        Int     @id @default(autoincrement())
  listingId Int
  stickerId Int

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sticker   Sticker @relation(fields: [stickerId], references: [id])

  @@unique([listingId, stickerId])
  @@map("listing_stickers")
}

// ─── Favorites ─────────────────────────────────────────────────────

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("favorites")
}

// ─── Saved Searches ────────────────────────────────────────────────

model SavedSearch {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String?  @db.VarChar(200)
  query     Json
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

// ─── Dealers (bilingual) ──────────────────────────────────────────

model Dealer {
  id             Int         @id @default(autoincrement())
  userId         Int         @unique
  companyName    String      @db.VarChar(200)
  companyNameRu  String?     @db.VarChar(200)
  logo           String?     @db.VarChar(500)
  descriptionEn  String?     @db.Text
  descriptionRu  String?     @db.Text
  website        String?     @db.VarChar(300)
  address        String?     @db.VarChar(300)
  addressRu      String?     @db.VarChar(300)
  phone          String?     @db.VarChar(30)
  dealerType     DealerType  @default(LOCAL)
  verified       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id])
  reviews        Review[]

  @@map("dealers")
}

enum DealerType {
  LOCAL
  INTERNATIONAL
}

// ─── Reviews ───────────────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  dealerId  Int
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([userId, dealerId])
  @@index([dealerId])
  @@map("reviews")
}

// ─── Messages ──────────────────────────────────────────────────────

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  subject    String?  @db.VarChar(255)
  body       String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

// ─── Auction ───────────────────────────────────────────────────────

model AuctionBid {
  id        Int      @id @default(autoincrement())
  listingId Int
  userId    Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([userId])
  @@map("auction_bids")
}

// ─── Rentals ───────────────────────────────────────────────────────

model Rental {
  id          Int          @id @default(autoincrement())
  listingId   Int
  renterId    Int
  startDate   DateTime
  endDate     DateTime
  totalPrice  Decimal      @db.Decimal(12, 2)
  status      RentalStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  listing     Listing      @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([renterId])
  @@map("rentals")
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── VIN Check History ─────────────────────────────────────────────

model VinCheck {
  id        Int      @id @default(autoincrement())
  vin       String   @db.VarChar(17)
  result    Json
  checkedAt DateTime @default(now())

  @@index([vin])
  @@map("vin_checks")
}

// ─── Technical Inspection ──────────────────────────────────────────

model TechnicalInspection {
  id             Int              @id @default(autoincrement())
  plateNumber    String           @db.VarChar(20)
  inspectionDate DateTime
  expiryDate     DateTime
  status         InspectionStatus @default(VALID)
  checkedAt      DateTime         @default(now())

  @@index([plateNumber])
  @@map("technical_inspections")
}

enum InspectionStatus {
  VALID
  EXPIRED
  DUE_SOON
}

// ─── Blog (bilingual) ─────────────────────────────────────────────

model BlogPost {
  id          Int       @id @default(autoincrement())
  slug        String    @unique @db.VarChar(300)
  titleEn     String    @db.VarChar(300)
  titleRu     String    @db.VarChar(300)
  excerptEn   String?   @db.VarChar(500)
  excerptRu   String?   @db.VarChar(500)
  contentEn   String    @db.LongText
  contentRu   String    @db.LongText
  coverImage  String?   @db.VarChar(500)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@map("blog_posts")
}

// ─── Auto Parts catalogue (bilingual) ─────────────────────────────

model AutoPart {
  id              Int      @id @default(autoincrement())
  slug            String   @unique @db.VarChar(160)
  nameEn          String   @db.VarChar(160)
  nameRu          String   @db.VarChar(160)
  categorySlug    String   @db.VarChar(80)
  categoryEn      String   @db.VarChar(80)
  categoryRu      String   @db.VarChar(80)
  descriptionEn   String   @db.Text
  descriptionRu   String   @db.Text
  functionEn      String   @db.Text
  functionRu      String   @db.Text
  replacementEn   String   @db.VarChar(400)
  replacementRu   String   @db.VarChar(400)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categorySlug])
  @@index([nameEn])
  @@map("auto_parts")
}

// ─── Help center tickets ──────────────────────────────────────────

model HelpTicket {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(255)
  topic     String   @db.VarChar(80)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("help_tickets")
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("verification_tokens")
}
